##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Iron_0.907_73.3_98.09_8_r1
PrimaryParticle Iron
PrimaryEnergy 0.90657 EeV
PrimaryZenAngle 73.30 deg
PrimaryAzimAngle 98.09 deg Magnetic
RandomSeed 0.348389233
################################################################################

