##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Iron_0.132_70.3_93.72_2_r0
PrimaryParticle Iron
PrimaryEnergy 0.1315 EeV
PrimaryZenAngle 70.32 deg
PrimaryAzimAngle 93.72 deg Magnetic
RandomSeed 0.877867904
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 11     -528.99    -1501.61        4.18
AddAntenna 13      -18.69    -2358.31       -9.71
AddAntenna 19      -23.85    -1786.23       -3.57
AddAntenna 23      -30.23    -1206.51        0.88
AddAntenna 27      479.39    -2066.74      -12.73
AddAntenna 31     -535.55     -923.31        9.82
AddAntenna 35      471.87    -1490.48       -8.23
AddAntenna 43      -48.97     -629.38        4.43
AddAntenna 47     -540.42     -342.46       12.30
AddAntenna 55      466.62     -909.31       -3.47
AddAntenna 81     -541.79      234.70       14.84
AddAntenna 91      455.40      247.63        3.23
AddAntenna 105      -56.07     1105.69       14.08
AddAntenna 119     -568.43     1964.50       25.11
####################################################################################
FresnelTime On
ZHAireS On
