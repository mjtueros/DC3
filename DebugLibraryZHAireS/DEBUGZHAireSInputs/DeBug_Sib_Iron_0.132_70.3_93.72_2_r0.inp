################################################################################

##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Iron_0.132_70.3_93.72_2_r0
PrimaryParticle Iron
PrimaryEnergy 0.1315 EeV
PrimaryZenAngle 70.32 deg
PrimaryAzimAngle 93.72 deg Magnetic
RandomSeed 0.877867904
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 1      594.26     -155.94        4.28
AddAntenna 2       90.54      124.09       12.25
AddAntenna 3       99.45     -458.58       12.69
AddAntenna 6      608.03     -744.72        2.96
AddAntenna 7      587.54      415.52        8.18
AddAntenna 8       82.43      702.59       16.84
AddAntenna 9      103.29    -1032.50       13.12
AddAntenna 12     -406.61     -167.75       21.85
AddAntenna 16     -412.23      407.42       22.26
AddAntenna 17     -400.13     -749.02       22.68
AddAntenna 20     -422.21      985.05       26.12
AddAntenna 28       81.34     1282.88       21.88
AddAntenna 29      107.98    -1609.80       13.26
AddAntenna 40     -426.66     1559.34       30.71
####################################################################################
FresnelTime On
ZHAireS On
####################################################################################
# CreateAntennaListInp Finished                                                    #
####################################################################################

####################################################################################
# Expected amplitude at each antenna, from the EventGenerator (its mock model,     #
# arbitrary units), for reference: AntennaID Amplitude                             #
# 1 1.400689e+02
# 2 2.231225e+02
# 3 2.637946e+02
# 6 1.233781e+02
# 7 1.131136e+02
# 8 3.825333e+02
