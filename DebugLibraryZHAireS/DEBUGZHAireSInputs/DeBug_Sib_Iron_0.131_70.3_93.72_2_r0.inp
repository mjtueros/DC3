##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Iron_0.131_70.3_93.72_2_r0
PrimaryParticle Iron
PrimaryEnergy 0.1315 EeV
PrimaryZenAngle 70.32 deg
PrimaryAzimAngle 93.72 deg Magnetic
RandomSeed 0.877867904
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
