################################################################################

##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Iron_0.159_71.6_92.02_4_r0
PrimaryParticle Iron
PrimaryEnergy 0.15931 EeV
PrimaryZenAngle 71.60 deg
PrimaryAzimAngle 92.02 deg Magnetic
RandomSeed 0.282426146
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 1      454.72      988.93        4.28
AddAntenna 2      -49.00     1268.96       12.25
AddAntenna 3      -40.09      686.29       12.69
AddAntenna 6      468.49      400.14        2.96
AddAntenna 8      -57.12     1847.45       16.84
AddAntenna 9      -36.25      112.37       13.12
AddAntenna 12     -546.15      977.11       21.85
AddAntenna 14      467.74     -170.81        4.09
AddAntenna 17     -539.67      395.84       22.68
AddAntenna 21     -533.75     -179.53       22.72
AddAntenna 29      -31.56     -464.93       13.26
AddAntenna 36      470.83     -745.27        3.23
AddAntenna 41     -528.38     -759.47       23.07
AddAntenna 45      -21.66    -1036.00       12.39
####################################################################################
FresnelTime On
ZHAireS On
####################################################################################
