##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName DeBug_Sib_Proton_0.282_72.2_95.54_1_r0
PrimaryParticle Proton
PrimaryEnergy 0.28178 EeV
PrimaryZenAngle 72.22 deg
PrimaryAzimAngle 95.54 deg Magnetic
RandomSeed 0.458606709
################################################################################

