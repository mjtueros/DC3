##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.0382_78.9_122.1_123_r0
PrimaryParticle Proton
PrimaryEnergy 0.03819 EeV
PrimaryZenAngle 78.93 deg
PrimaryAzimAngle 122.14 deg Magnetic
RandomSeed 0.196197809
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 19      387.15     4581.82       21.59
AddAntenna 23      380.77     5161.54       26.04
AddAntenna 27      890.40     4301.31       12.43
AddAntenna 31     -124.54     5444.74       34.98
AddAntenna 35      882.88     4877.57       16.93
AddAntenna 39     1385.85     4015.25        2.21
AddAntenna 43      362.04     5738.68       29.59
AddAntenna 47     -129.41     6025.60       37.46
AddAntenna 50     1399.35     3441.67        0.00
AddAntenna 51     1389.78     4596.10        8.84
AddAntenna 55      877.63     5458.74       21.69
AddAntenna 81     -130.78     6602.75       40.00
AddAntenna 85     1373.81     5754.05       17.12
AddAntenna 91      866.41     6615.69       28.39
AddAntenna 93     -645.27     7463.70       52.29
