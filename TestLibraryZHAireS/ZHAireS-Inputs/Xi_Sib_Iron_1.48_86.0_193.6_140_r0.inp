##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_1.48_86.0_193.6_140_r0
PrimaryParticle Iron
PrimaryEnergy 1.4814 EeV
PrimaryZenAngle 85.96 deg
PrimaryAzimAngle 193.64 deg Magnetic
RandomSeed 0.500294160
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 10     3740.75     4685.21       20.11
AddAntenna 14     3245.77     4392.73       29.25
AddAntenna 21     2244.28     4384.01       47.88
AddAntenna 22     4248.05     4403.37       11.60
AddAntenna 29     2746.47     4098.61       38.42
AddAntenna 30     3746.68     4109.84       19.92
AddAntenna 34     4742.35     4698.42        3.48
AddAntenna 36     3248.86     3818.27       28.39
AddAntenna 41     2249.65     3804.07       48.23
AddAntenna 42     4252.62     3826.51       10.81
AddAntenna 45     2756.38     3527.55       37.55
AddAntenna 46     3751.85     3538.43       18.90
AddAntenna 50     5237.44     4992.93        0.00
AddAntenna 53     1748.17     4088.89       58.35
AddAntenna 54     4749.34     4122.36        3.80
####################################################################################
FresnelTime On
ZHAireS On
