##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_0.109_84.2_57.68_194_r0
PrimaryParticle Iron
PrimaryEnergy 0.10883 EeV
PrimaryZenAngle 84.21 deg
PrimaryAzimAngle 57.68 deg Magnetic
RandomSeed 0.599333746
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 20     2620.69    -1121.64       51.28
AddAntenna 32     2127.07    -1415.87       56.25
AddAntenna 38     1636.51    -2282.39       68.38
AddAntenna 40     2616.23     -547.34       55.87
AddAntenna 44     3114.38     -250.14       50.80
AddAntenna 48     1622.28    -1701.35       66.38
AddAntenna 52     2118.78     -838.82       59.86
AddAntenna 78     3105.69      324.73       54.74
AddAntenna 82     1624.00     -552.26       69.69
AddAntenna 88     2108.67      319.76       68.82
AddAntenna 93     3597.22     1199.87       52.29
