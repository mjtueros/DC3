##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.0921_85.0_185.6_35_r0
PrimaryParticle Proton
PrimaryEnergy 0.09215 EeV
PrimaryZenAngle 85.01 deg
PrimaryAzimAngle 185.61 deg Magnetic
RandomSeed 0.850280446
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 28    -3404.84    -3232.63       47.04
AddAntenna 37    -2910.51    -2940.75       43.15
AddAntenna 40    -3912.84    -2956.17       55.87
AddAntenna 43    -1924.54    -2933.98       29.59
AddAntenna 44    -3414.69    -2658.96       50.80
AddAntenna 47    -2415.99    -2647.06       37.46
