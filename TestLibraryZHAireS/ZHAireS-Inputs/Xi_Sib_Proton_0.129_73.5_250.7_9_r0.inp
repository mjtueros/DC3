################################################################################

##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.129_73.5_250.7_9_r0
PrimaryParticle Proton
PrimaryEnergy 0.12911 EeV
PrimaryZenAngle 73.50 deg
PrimaryAzimAngle 250.74 deg Magnetic
RandomSeed 0.831301576
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 5     -727.91     -442.86       25.05
AddAntenna 10     -714.68    -1597.89       20.11
AddAntenna 13     -225.03     -722.10       15.45
AddAntenna 18     -215.23    -1300.62       11.40
AddAntenna 19     -230.19     -150.02       21.59
AddAntenna 22     -207.38    -1879.73       11.60
AddAntenna 23     -236.57      429.70       26.04
AddAntenna 26      278.43    -1006.74        7.77
AddAntenna 27      273.05     -430.53       12.43
AddAntenna 30     -708.75    -2173.26       19.92
AddAntenna 35      265.53      145.73       16.93
AddAntenna 43     -255.31     1006.84       29.59
AddAntenna 55      260.28      726.90       21.69
AddAntenna 85      756.47     1022.21       17.12
AddAntenna 91      249.06     1883.85       28.39
####################################################################################
FresnelTime On
ZHAireS On
####################################################################################
# CreateAntennaListInp Finished                                                    #
####################################################################################

####################################################################################
# Expected amplitude at each antenna, from the EventGenerator (its mock model,     #
# arbitrary units), for reference: AntennaID Amplitude                             #
# 5 6.437875e-04
# 10 6.791972e-04
# 13 6.469454e-04
# 18 6.642919e-04
# 19 6.303482e-04
# 22 6.823397e-04
# 23 6.140955e-04
