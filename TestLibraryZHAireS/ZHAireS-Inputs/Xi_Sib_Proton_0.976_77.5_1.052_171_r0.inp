##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.976_77.5_1.052_171_r0
PrimaryParticle Proton
PrimaryEnergy 0.97582 EeV
PrimaryZenAngle 77.47 deg
PrimaryAzimAngle 1.05 deg Magnetic
RandomSeed 0.373447462
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
