##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.271_80.2_106.1_235_r0
PrimaryParticle Proton
PrimaryEnergy 0.27076 EeV
PrimaryZenAngle 80.24 deg
PrimaryAzimAngle 106.12 deg Magnetic
RandomSeed 0.974651492
################################################################################

