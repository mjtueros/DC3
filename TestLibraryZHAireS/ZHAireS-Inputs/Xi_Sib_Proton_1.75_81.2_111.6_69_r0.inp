##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_1.75_81.2_111.6_69_r0
PrimaryParticle Proton
PrimaryEnergy 1.7496 EeV
PrimaryZenAngle 81.22 deg
PrimaryAzimAngle 111.58 deg Magnetic
RandomSeed 0.841212224
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 23    -1286.28     -253.91       26.04
AddAntenna 26     -771.28    -1690.36        7.77
AddAntenna 27     -776.66    -1114.14       12.43
AddAntenna 35     -784.17     -537.88       16.93
