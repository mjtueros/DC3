##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_0.0816_76.5_335.4_46_r0
PrimaryParticle Iron
PrimaryEnergy 0.08158 EeV
PrimaryZenAngle 76.51 deg
PrimaryAzimAngle 335.37 deg Magnetic
RandomSeed 0.356637486
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 23     1625.42    -1435.28       26.04
AddAntenna 31     1120.11    -1152.08       34.98
AddAntenna 35     2127.53    -1719.25       16.93
AddAntenna 37      620.72     -864.92       43.15
