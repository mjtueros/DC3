##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_1.15_74.4_310.0_104_r0
PrimaryParticle Iron
PrimaryEnergy 1.1528 EeV
PrimaryZenAngle 74.36 deg
PrimaryAzimAngle 310.02 deg Magnetic
RandomSeed 0.110067469
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 2      840.86     -210.71       37.41
AddAntenna 3      849.77     -793.38       37.85
AddAntenna 6     1358.35    -1079.53       28.12
AddAntenna 9      853.61    -1367.30       38.28
AddAntenna 12      343.71     -502.56       47.01
AddAntenna 14     1357.60    -1650.49       29.25
AddAntenna 16      338.09       72.61       47.42
