##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_0.161_85.5_58.35_30_r0
PrimaryParticle Iron
PrimaryEnergy 0.16089 EeV
PrimaryZenAngle 85.54 deg
PrimaryAzimAngle 58.35 deg Magnetic
RandomSeed 0.154959559
################################################################################

