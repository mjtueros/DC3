##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.236_80.0_77.03_49_r0
PrimaryParticle Proton
PrimaryEnergy 0.23567 EeV
PrimaryZenAngle 79.97 deg
PrimaryAzimAngle 77.03 deg Magnetic
RandomSeed 0.498004592
################################################################################

