##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_3.2_82.7_31.66_31_r0
PrimaryParticle Proton
PrimaryEnergy 3.1951 EeV
PrimaryZenAngle 82.68 deg
PrimaryAzimAngle 31.66 deg Magnetic
RandomSeed 0.361172255
################################################################################

