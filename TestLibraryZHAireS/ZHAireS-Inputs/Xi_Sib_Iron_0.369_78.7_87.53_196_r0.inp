##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_0.369_78.7_87.53_196_r0
PrimaryParticle Iron
PrimaryEnergy 0.36938 EeV
PrimaryZenAngle 78.72 deg
PrimaryAzimAngle 87.53 deg Magnetic
RandomSeed 0.432357715
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 13     -441.29     4954.42       15.45
AddAntenna 18     -431.49     4375.90       11.40
AddAntenna 22     -423.64     3796.79       11.60
AddAntenna 26       62.17     4669.78        7.77
AddAntenna 27       56.79     5246.00       12.43
AddAntenna 34       70.66     4091.84        3.48
AddAntenna 35       49.28     5822.25       16.93
AddAntenna 39      552.25     4959.93        2.21
AddAntenna 42     -419.07     3219.93       10.81
AddAntenna 46     -919.85     2931.85       18.90
AddAntenna 50      565.75     4386.35        0.00
AddAntenna 51      556.17     5540.78        8.84
AddAntenna 54       77.65     3515.78        3.80
####################################################################################
FresnelTime On
ZHAireS On
####################################################################################
