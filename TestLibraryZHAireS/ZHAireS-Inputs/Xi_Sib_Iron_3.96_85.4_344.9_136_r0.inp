##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Iron_3.96_85.4_344.9_136_r0
PrimaryParticle Iron
PrimaryEnergy 3.9635 EeV
PrimaryZenAngle 85.38 deg
PrimaryAzimAngle 344.94 deg Magnetic
RandomSeed 0.541991803
################################################################################

