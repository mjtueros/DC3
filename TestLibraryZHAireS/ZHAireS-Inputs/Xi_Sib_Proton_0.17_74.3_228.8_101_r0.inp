##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_0.17_74.3_228.8_101_r0
PrimaryParticle Proton
PrimaryEnergy 0.17019 EeV
PrimaryZenAngle 74.31 deg
PrimaryAzimAngle 228.84 deg Magnetic
RandomSeed 0.729376984
################################################################################

####################################################################################
# Antenna List created with CreateAntennaListInp v0.1                              #
####################################################################################
AddAntenna 1      421.43      201.67       29.43
AddAntenna 2      -82.29      481.70       37.41
AddAntenna 3      -73.38     -100.97       37.85
AddAntenna 5      916.20      489.44       25.05
AddAntenna 6      435.20     -387.11       28.12
AddAntenna 7      414.70      773.12       33.34
AddAntenna 9      -69.54     -674.89       38.28
AddAntenna 11      908.78     1066.91       29.34
AddAntenna 12     -579.44      189.86       47.01
AddAntenna 15      405.81     1352.49       38.90
AddAntenna 17     -572.96     -391.41       47.84
AddAntenna 19     1413.92      782.29       21.59
AddAntenna 21     -567.04     -966.79       47.88
AddAntenna 23     1407.54     1362.01       26.04
AddAntenna 31      902.23     1645.21       34.98
AddAntenna 33    -1067.78     -686.43       58.03
AddAntenna 43     1388.80     1939.14       29.59
AddAntenna 53    -1063.15    -1261.90       58.35
####################################################################################
FresnelTime On
ZHAireS On
####################################################################################
# CreateAntennaListInp Finished                                                    #
####################################################################################

####################################################################################
# Expected amplitude at each antenna, from the EventGenerator (its mock model,     #
# arbitrary units), for reference: AntennaID Amplitude                             #
# 1 5.694012e-04
# 2 5.725799e-04
# 3 5.842544e-04
# 5 5.553690e-04
# 6 5.807790e-04
