##############################################################################
# Aires simulation header generated with CreateAiresInputHeader                #
################################################################################
TaskName Xi_Sib_Proton_1.53_81.0_348.3_219_r0
PrimaryParticle Proton
PrimaryEnergy 1.5286 EeV
PrimaryZenAngle 80.96 deg
PrimaryAzimAngle 348.32 deg Magnetic
RandomSeed 0.873205304
################################################################################

